# Generate a long random value for production. Never commit the real secret.
SECRET_KEY=replace-with-a-long-random-value

# Point this to a trusted local copy of the trained model.
MODEL_PATH=models/full_model.keras

# Optional chatbot configuration.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# Set to true only when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
PORT=5000
